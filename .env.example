# Origine pubblica attendibile usata per i metadati social assoluti.
NEXT_PUBLIC_SITE_URL=https://example.invalid

# Provider IA preferito. Le chiavi restano soltanto sul server: non usare mai NEXT_PUBLIC_.
AI_PROVIDER=grok
XAI_API_KEY=

# Motore specializzato per scontornare i prodotti. Se BRIA non è configurata,
# l'app usa automaticamente Grok Imagine come fallback.
PRODUCT_CLEANER=bria
BRIA_API_KEY=

# Motore dedicato ai render e agli interventi con maschera.
RENDER_PROVIDER=openai
OPENAI_API_KEY=
